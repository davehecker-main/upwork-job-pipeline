# Copy to .env and fill in. .env is gitignored and must never be committed.

# console.anthropic.com -> API keys. Starts sk-ant-api03-
ANTHROPIC_API_KEY=

# Your n8n instance, no trailing slash. e.g. https://dave.app.n8n.cloud
# For self-hosted Docker on the micro PC: http://localhost:5678
N8N_BASE_URL=

# n8n Settings -> n8n API -> Create an API key
N8N_API_KEY=

# Slack app: OAuth & Permissions -> Bot User OAuth Token, after Install
SLACK_BOT_TOKEN=

# Channel IDs (C...). scripts/setup-slack.mjs creates the channels and fills
# these in for you.
SLACK_CHANNEL=
SLACK_TEST_CHANNEL=

# Gmail IMAP. IMAP_PASSWORD is the 16-character app password, NOT your Google
# password. Spaces in it are fine - they get stripped.
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=vollna-alerts

# Workflow IDs. scripts/setup-n8n.mjs fills these in; they activate the drift
# check in ./test.sh.
N8N_WF1_ID=
N8N_WF3_ID=

# Copy to .env and fill in. .env is gitignored and must never be committed.

# console.anthropic.com -> API keys. Starts sk-ant-api03-
ANTHROPIC_API_KEY=

# Your Upwork freelancer org_uid, from the MCP tool list_accounts
UPWORK_ORG_UID=

# Slack app: OAuth & Permissions -> Bot User OAuth Token, after Install
SLACK_BOT_TOKEN=

# Channel IDs (C...). scripts/setup-slack.mjs creates the channels and fills
# these in for you.
SLACK_CHANNEL=
SLACK_TEST_CHANNEL=



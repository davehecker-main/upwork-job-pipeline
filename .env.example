# Copy to .env and fill in. .env is gitignored and must never be committed.

# console.anthropic.com -> API keys. Starts sk-ant-api03-
ANTHROPIC_API_KEY=

# Your n8n instance, no trailing slash. e.g. https://dave.app.n8n.cloud
# For self-hosted Docker on the micro PC: http://localhost:5678
N8N_BASE_URL=

# n8n Settings -> n8n API -> Create an API key
N8N_API_KEY=

# Slack channel ID (C...) used by headless/resume-path test runs
SLACK_TEST_CHANNEL=

# Workflow IDs, filled in after the first import into n8n
N8N_WF1_ID=
N8N_WF3_ID=
